{
  "name": "zappy",
  "private": true,
  "version": "1.0.0",
  "description": "Private local Tesla dashboard, read-only Fleet API toolkit, and OAuth callback site",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test",
    "privacy": "node scripts/privacy-audit.cjs",
    "check": "npm test && npm run privacy",
    "demo": "node scripts/zappy.cjs demo",
    "zappy": "node scripts/zappy.cjs",
    "login": "node scripts/oauth-login.cjs",
    "dashboard": "node scripts/dashboard-server.cjs",
    "dashboard:demo": "node scripts/dashboard-server.cjs --demo --port 8767"
  }
}
